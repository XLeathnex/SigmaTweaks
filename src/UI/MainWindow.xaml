<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SigmaTweaks"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0E1013"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0E1013"/>
        <SolidColorBrush x:Key="Panel" Color="#16191F"/>
        <SolidColorBrush x:Key="Panel2" Color="#1D2129"/>
        <SolidColorBrush x:Key="Line" Color="#2A2F3A"/>
        <SolidColorBrush x:Key="Fg" Color="#E6E9EF"/>
        <SolidColorBrush x:Key="Muted" Color="#8A93A6"/>
        <SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#9179FF"/>
        <SolidColorBrush x:Key="Ok" Color="#3FCF8E"/>
        <SolidColorBrush x:Key="Warn" Color="#F5A524"/>
        <SolidColorBrush x:Key="Danger" Color="#F03D5F"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3F4C"/>
                                <Setter Property="Foreground" Value="#8A93A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#101318"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="Margin" Value="8,2"/>
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome" CornerRadius="6" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="#1D2129"/>
                                            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Accent}" CornerRadius="8" Width="34" Height="34">
                            <TextBlock Text="&#931;" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SigmaTweaks" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="SubtitleText" Text="Windows 11 optimization" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="SystemText" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="2" x:Name="AdminBadge" CornerRadius="12" Padding="12,5"
                            Background="#1D2129" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminText" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="CategoryList" Style="{StaticResource NavList}" Margin="0,10"/>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" Grid.Column="0" VerticalContentAlignment="Center"
                                 ToolTip="Filter by name, description or id"/>
                        <Button x:Name="SelectAllButton" Grid.Column="1" Content="Select all"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                        <Button x:Name="SelectNoneButton" Grid.Column="2" Content="Clear"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                        <Button x:Name="RefreshButton" Grid.Column="3" Content="Refresh state"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                    </Grid>

                    <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="18,0,18,12">
                        <StackPanel x:Name="ContentPanel"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Preset" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                    <ComboBox x:Name="PresetCombo" Grid.Column="1" Width="170" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="RestorePointCheck" Grid.Column="2" Margin="18,0,0,0"
                              Content="Create restore point first" IsChecked="True" VerticalAlignment="Center"/>

                    <TextBlock x:Name="SelectionText" Grid.Column="3" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"/>

                    <Button x:Name="RevertButton" Grid.Column="4" Content="Revert selected"
                            Style="{StaticResource GhostButton}"/>
                    <Button x:Name="ApplyButton" Grid.Column="5" Content="Apply selected"
                            Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Log -->
            <Border Grid.Row="3" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Expander x:Name="LogExpander" Header="Activity log" Foreground="{StaticResource Muted}"
                          Padding="18,6" IsExpanded="False">
                    <TextBox x:Name="LogBox" Height="150" Margin="18,6,18,12"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="#0A0C0F"/>
                </Expander>
            </Border>
        </Grid>

        <!-- Busy overlay -->
        <Border x:Name="BusyOverlay" Background="#CC0E1013" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="BusyText" Text="Working..." FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Do not close this window" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
